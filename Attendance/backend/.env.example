# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated frontend origins allowed to call the API (required in production),
# e.g. https://your-app.vercel.app (no trailing slash)
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (Render, Heroku, Nginx: 1).
# Defaults to 1 in production and 0 otherwise.
# TRUST_PROXY=1
# LOG_LEVEL=info

# --- Database -----------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/attendance-tracker

# --- Authentication -----------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# BCRYPT_ROUNDS=12

# Google Sign-In: OAuth client id from Google Cloud Console.
# Must match VITE_GOOGLE_CLIENT_ID in the frontend. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# --- Absence email notifications ----------------------------------------------
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords).
# Without credentials, development uses a throwaway Ethereal inbox and
# production skips sending.
EMAIL_USER=
EMAIL_PASS=
# EMAIL_SERVICE=gmail
# EMAIL_FROM="Attendance Tracker" <no-reply@attendance-tracker.com>
# EMAIL_ENABLED=true

# --- Self check-in --------------------------------------------------------------
# Maximum distance (meters) between a student and the teacher's location.
CHECKIN_RADIUS_METERS=200
