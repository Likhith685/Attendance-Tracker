# Copy this file to `.env` (or `.env.local`) for local development.
# In production, set these in your hosting provider's environment settings.

# Base URL of the backend (without the /api suffix). Required for production builds.
VITE_API_URL=http://localhost:5000

# Google OAuth client id; must match GOOGLE_CLIENT_ID on the backend.
# Leave empty to hide the "Sign in with Google" buttons.
VITE_GOOGLE_CLIENT_ID=
